# Shared look of every recording. Sourced by the other tapes, which run
# from the repository root through docs/record.sh.

Set Shell "bash"
Set FontSize 15
Set Width 1280
Set Height 760
Set Padding 12
Set Margin 22
Set MarginFill "#F0B35A"
Set WindowBar Colorful
Set BorderRadius 10
Set Framerate 24
Set TypingSpeed 55ms
Set Theme { "name": "Nuit", "black": "#141318", "red": "#EE8E7A", "green": "#7CCB8A", "yellow": "#F0B35A", "blue": "#8FB8F0", "magenta": "#C59BEA", "cyan": "#6FC7C1", "white": "#E6E1EA", "brightBlack": "#8E8799", "brightRed": "#EE8E7A", "brightGreen": "#7CCB8A", "brightYellow": "#F0B35A", "brightBlue": "#8FB8F0", "brightMagenta": "#C59BEA", "brightCyan": "#6FC7C1", "brightWhite": "#FFFFFF", "background": "#141318", "foreground": "#E6E1EA", "selection": "#2A2633", "cursor": "#F0B35A" }

Hide
Type "export PATH=$PWD/target/release:$PATH PS1='$ ' && clear"
Enter
Sleep 300ms
